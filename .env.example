# ── Supabase (Project Settings → API Keys → "Publishable and secret API keys") ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key: safe in the browser, RLS protects data. Starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret key: SERVER ONLY. Never prefix with NEXT_PUBLIC_. Starts with sb_secret_
# Used for: "Send invite" emails and the /api/health database check. Optional otherwise.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public site URL, no trailing slash (auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google OAuth Web Client ID for "Open in Google Docs / Sheets"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
